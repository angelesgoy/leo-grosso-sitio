---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ArticleFeatured from '../components/ArticleFeatured.astro';
import ArticleList from '../components/ArticleList.astro';
import { getArticles } from '../services/content';

const articles = await getArticles();
const featuredArticle = articles.find((article) => article.featured) || (articles.length > 0 ? articles[0] : null);
const remainingArticles = featuredArticle
  ? articles.filter((article) => article.id !== featuredArticle.id)
  : articles;
---
<BaseLayout title="Escribo · Leon Grosso" description="Mis ensayos y análisis sobre violencia, seguridad democrática y territorio.">
  <PageHero kicker="Producción" title="Escribo" lede="Ensayos y análisis que publiqué principalmente en El Cohete a la Luna. Violencia, narcomenudeo, homicidios, seguridad democrática y territorio." />
  <section class="section">
    <div class="container">
      {articles.length === 0 ? (
        <div class="feed-empty">No hay artículos disponibles por el momento.</div>
      ) : (
        <>
          {featuredArticle && <ArticleFeatured article={featuredArticle} />}
          {remainingArticles.length > 0 && <ArticleList articles={remainingArticles} />}
        </>
      )}
    </div>
  </section>

  <!-- SINCRONIZACIÓN EN TIEMPO REAL DEL ARTÍCULO DESTACADO SELECCIONADO EN EL PANEL -->
  <script is:inline>
    (async function syncFeaturedArticle() {
      try {
        const query = encodeURIComponent('*[_type == "article" && featured == true][0]');
        const res = await fetch(`https://j4xtzihv.api.sanity.io/v2024-01-01/data/query/production?query=${query}`);
        if (!res.ok) return;
        const json = await res.json();
        const featured = json.result;
        if (!featured || !featured.title) return;

        const container = document.querySelector('.article-featured');
        if (!container) return;

        const titleEl = container.querySelector('h3');
        if (titleEl && titleEl.textContent !== featured.title) {
          titleEl.textContent = featured.title;
          
          const metaEl = container.querySelector('.meta');
          if (metaEl) {
            const parts = featured.publishedAt ? featured.publishedAt.split('T')[0].split('-') : [];
            const dateStr = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : '';
            metaEl.innerHTML = `Artículo destacado · ${featured.publication || 'El Cohete a la Luna'} · <time datetime="${featured.publishedAt || ''}">${dateStr}</time>`;
          }

          const authorEl = container.querySelector('.article-author');
          if (authorEl) authorEl.textContent = featured.authors || 'Leonardo Grosso';

          const excerptEl = container.querySelector('.excerpt');
          if (excerptEl) excerptEl.textContent = featured.excerpt || '';

          const linkEl = container.querySelector('.link-arrow');
          if (linkEl) {
            if (featured.externalUrl) linkEl.href = featured.externalUrl;
            linkEl.innerHTML = `Leer en ${featured.publication || 'El Cohete a la Luna'} <span class="arrow">↗</span>`;
          }

          const imgEl = container.querySelector('.thumb img');
          if (imgEl && featured.image?.asset?._ref) {
            const match = featured.image.asset._ref.match(/^image-([a-fA-F0-9]+)-(\d+x\d+)-(\w+)$/);
            if (match) {
              imgEl.src = `https://cdn.sanity.io/images/j4xtzihv/production/${match[1]}-${match[2]}.${match[3]}`;
            }
          }
        }
      } catch (e) {
        // Fallback silencioso
      }
    })();
  </script>
</BaseLayout>
