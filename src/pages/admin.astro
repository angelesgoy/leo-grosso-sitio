---
import BaseLayout from '../layouts/BaseLayout.astro';
const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID || 'j4xtzihv';
const dataset = import.meta.env.PUBLIC_SANITY_DATASET || 'production';
---

<BaseLayout title="Acceso Equipo · Leon Grosso" description="Panel privado de gestión para el equipo de prensa.">
  
  <!-- PANTALLA 1: LOGIN SEGURO (Visible si no está autenticado) -->
  <section id="login-section" class="section" style="min-height: 70vh; display: flex; align-items: center;">
    <div class="container" style="max-width: 460px;">
      <div style="background: var(--soft-bg); padding: 2.5rem; border: 1px solid var(--border); text-align: center;">
        <span class="kicker">Área Privada</span>
        <h1 class="t-section" style="margin: 0.75rem 0 0.5rem; font-size: 1.75rem;">Acceso Equipo</h1>
        <p class="t-body" style="font-size: 0.875rem; color: var(--dim-gray); margin-bottom: 2rem;">
          Ingresá la clave de autorización para administrar los artículos de la web.
        </p>

        <div id="login-alert" style="display: none; padding: 0.75rem; margin-bottom: 1.25rem; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; font-size: 0.85rem; font-weight: 600;"></div>

        <form id="login-form" style="display: flex; flex-direction: column; gap: 1rem;">
          <input
            type="password"
            id="password-input"
            required
            placeholder="Clave de acceso..."
            style="width: 100%; padding: 0.9rem 1rem; border: 1px solid var(--border); font-size: 1rem; background: var(--bg); color: var(--text);"
          />
          <button
            type="submit"
            style="padding: 1rem; background: var(--leo-blue); color: #000; font-weight: 800; border: none; font-size: 0.9375rem; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer;"
          >
            🔒 Entrar al Panel
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- PANTALLA 2: FORMULARIO DE CARGA (Visible solo cuando la clave es correcta) -->
  <div id="admin-panel-content" style="display: none;">
    <section class="page-hero">
      <div class="container" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="kicker">Gestión de Prensa</span>
          <h1 class="t-page page-title">Publicar Artículo<span class="title-dot">.</span></h1>
          <p class="page-hero-lede">Formulario simplificado para cargar o eliminar notas de la web.</p>
        </div>
        <button id="logout-btn" style="padding: 0.5rem 1rem; background: transparent; border: 1px solid var(--border); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; cursor: pointer; color: var(--dim-gray);">
          🔒 Cerrar sesión
        </button>
      </div>
    </section>

    <section class="section">
      <div class="container" style="max-width: 800px;">
        
        <div id="status-alert" style="display: none; padding: 1rem 1.5rem; margin-bottom: 2rem; border-radius: 4px; font-weight: 600;"></div>

        <form id="article-form" style="display: flex; flex-direction: column; gap: 1.5rem; background: var(--soft-bg); padding: 2rem; border: 1px solid var(--border);">
          
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
              Título del artículo *
            </label>
            <input type="text" id="title" required placeholder="Ej: A las armas las carga el narco" style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border); font-size: 1rem; background: var(--bg); color: var(--text);" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            <div>
              <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
                Medio / Diario *
              </label>
              <input type="text" id="publication" required value="El Cohete a la Luna" style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border); font-size: 1rem; background: var(--bg); color: var(--text);" />
            </div>
            <div>
              <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
                Fecha de publicación *
              </label>
              <input type="date" id="publishedAt" required style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border); font-size: 1rem; background: var(--bg); color: var(--text);" />
            </div>
          </div>

          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
              Autor / Coautores *
            </label>
            <input type="text" id="authors" required value="Leonardo Grosso" placeholder="Ej: Leonardo Grosso + Vanina Pasik" style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border); font-size: 1rem; background: var(--bg); color: var(--text);" />
          </div>

          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
              Bajada / Resumen *
            </label>
            <textarea id="excerpt" rows="3" required placeholder="Breve resumen del artículo que se mostrará en el listado..." style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border); font-size: 1rem; background: var(--bg); color: var(--text); resize: vertical;"></textarea>
          </div>

          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
              URL externa a la nota original *
            </label>
            <input type="url" id="externalUrl" required placeholder="https://www.elcohetealaluna.com/..." style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border); font-size: 1rem; background: var(--bg); color: var(--text);" />
          </div>

          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
              Imagen del artículo (Opcional)
            </label>
            <input type="file" id="imageFile" accept="image/*" style="width: 100%; padding: 0.5rem; border: 1px dashed var(--border); background: var(--bg);" />
          </div>

          <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.5rem;">
            <input type="checkbox" id="featured" style="width: 20px; height: 20px; accent-color: var(--leo-blue);" />
            <label for="featured" style="font-size: 0.9375rem; font-weight: 600; cursor: pointer;">
              ⭐ Marcar como artículo destacado (aparecerá arriba en portada y en Escribe)
            </label>
          </div>

          <button type="submit" id="submit-btn" style="padding: 1.15rem 2rem; background: var(--leo-blue); color: #000; font-weight: 800; border: none; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: var(--t); margin-top: 1rem;">
            🚀 Publicar Artículo en la Web
          </button>
        </form>

        <!-- Lista de artículos publicados -->
        <div style="margin-top: 4rem;">
          <h2 class="t-h3" style="margin-bottom: 1.5rem;">Artículos Publicados</h2>
          <div id="articles-manage-list">Cargando artículos...</div>
        </div>

      </div>
    </section>
  </div>

  <script define:vars={{ projectId, dataset }}>
    const AUTH_KEY = 'sanity_team_write_token';
    const loginSection = document.getElementById('login-section');
    const adminContent = document.getElementById('admin-panel-content');
    const loginForm = document.getElementById('login-form');
    const passwordInput = document.getElementById('password-input');
    const loginAlert = document.getElementById('login-alert');
    const logoutBtn = document.getElementById('logout-btn');

    let currentToken = localStorage.getItem(AUTH_KEY) || '';

    // Validar si un token funciona contra Sanity
    async function testToken(token) {
      if (!token) return false;
      try {
        const url = `https://${projectId}.api.sanity.io/v2024-01-01/data/query/${dataset}?query=count(*[_type == "article"])`;
        const res = await fetch(url, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        return res.ok;
      } catch {
        return false;
      }
    }

    // Inicializar vista según estado de autenticación
    async function initAuth() {
      if (currentToken) {
        const isValid = await testToken(currentToken);
        if (isValid) {
          showAdminPanel();
          return;
        }
      }
      showLoginScreen();
    }

    function showLoginScreen() {
      if (loginSection) loginSection.style.display = 'flex';
      if (adminContent) adminContent.style.display = 'none';
    }

    function showAdminPanel() {
      if (loginSection) loginSection.style.display = 'none';
      if (adminContent) adminContent.style.display = 'block';
      loadArticlesList();
    }

    // Login Form Submit
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const enteredToken = passwordInput.value.trim();
      if (!enteredToken) return;

      if (loginAlert) loginAlert.style.display = 'none';

      const isValid = await testToken(enteredToken);
      if (isValid) {
        currentToken = enteredToken;
        localStorage.setItem(AUTH_KEY, currentToken);
        showAdminPanel();
      } else {
        if (loginAlert) {
          loginAlert.style.display = 'block';
          loginAlert.textContent = '❌ Clave incorrecta o no autorizada. Verificá tu clave de equipo.';
        }
      }
    });

    // Logout
    logoutBtn?.addEventListener('click', () => {
      localStorage.removeItem(AUTH_KEY);
      currentToken = '';
      showLoginScreen();
    });

    // Formulario de publicación
    const dateInput = document.getElementById('publishedAt');
    if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];

    const articleForm = document.getElementById('article-form');
    const statusAlert = document.getElementById('status-alert');
    const submitBtn = document.getElementById('submit-btn');

    function showAlert(msg, isSuccess) {
      if (!statusAlert) return;
      statusAlert.style.display = 'block';
      statusAlert.style.background = isSuccess ? '#d4edda' : '#f8d7da';
      statusAlert.style.color = isSuccess ? '#155724' : '#721c24';
      statusAlert.style.border = isSuccess ? '1px solid #c3e6cb' : '1px solid #f5c6cb';
      statusAlert.textContent = msg;
    }

    async function uploadImage(file) {
      if (!file) return null;
      const uploadUrl = `https://${projectId}.api.sanity.io/v2024-01-01/assets/images/${dataset}`;
      const res = await fetch(uploadUrl, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${currentToken}`,
          'Content-Type': file.type
        },
        body: file
      });
      if (!res.ok) throw new Error('Error al subir la imagen');
      const data = await res.json();
      return {
        _type: 'image',
        asset: { _type: 'reference', _ref: data.document._id }
      };
    }

    articleForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentToken) {
        showLoginScreen();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = '⏳ Publicando...';
      showAlert('Procesando y publicando artículo...', true);

      try {
        const title = document.getElementById('title').value.trim();
        const slugStr = title.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)+/g, "");
        const imageFile = document.getElementById('imageFile')?.files?.[0];
        let imageAsset = null;

        if (imageFile) {
          imageAsset = await uploadImage(imageFile);
        }

        const doc = {
          _type: 'article',
          _id: `article-${Date.now()}`,
          title: title,
          slug: { _type: 'slug', current: slugStr },
          publication: document.getElementById('publication').value.trim(),
          publishedAt: document.getElementById('publishedAt').value,
          authors: document.getElementById('authors').value.trim(),
          excerpt: document.getElementById('excerpt').value.trim(),
          externalUrl: document.getElementById('externalUrl').value.trim(),
          featured: document.getElementById('featured').checked,
          status: 'published',
          ...(imageAsset ? { image: imageAsset } : {})
        };

        const mutateUrl = `https://${projectId}.api.sanity.io/v2024-01-01/data/mutate/${dataset}`;
        const res = await fetch(mutateUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${currentToken}`
          },
          body: JSON.stringify({ mutations: [{ createOrReplace: doc }] })
        });

        if (res.ok) {
          showAlert('✅ ¡Artículo publicado exitosamente! La web se actualizará en unos segundos.', true);
          articleForm.reset();
          if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
          loadArticlesList();
        } else {
          const errData = await res.json();
          showAlert(`❌ Error al publicar: ${errData.error?.description || 'Verifica la clave de autorización.'}`, false);
        }
      } catch (err) {
        showAlert(`❌ Error: ${err.message}`, false);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '🚀 Publicar Artículo en la Web';
      }
    });

    async function loadArticlesList() {
      const container = document.getElementById('articles-manage-list');
      if (!container) return;

      const query = encodeURIComponent(`*[_type == "article"] | order(publishedAt desc)`);
      const url = `https://${projectId}.api.sanity.io/v2024-01-01/data/query/${dataset}?query=${query}`;

      try {
        const res = await fetch(url);
        const json = await res.json();
        const articles = json.result || [];

        if (articles.length === 0) {
          container.innerHTML = '<p style="color: var(--dim-gray);">No hay artículos cargados en el CMS aún.</p>';
          return;
        }

        container.innerHTML = articles.map(art => `
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--border); gap: 1rem;">
            <div>
              <strong>${art.featured ? '⭐ ' : ''}${art.title}</strong>
              <div style="font-size: 0.75rem; color: var(--dim-gray);">${art.publication || ''} · ${art.publishedAt || ''}</div>
            </div>
            <button onclick="deleteArticle('${art._id}')" style="background: #dc3545; color: white; border: none; padding: 0.5rem 0.85rem; font-size: 0.75rem; cursor: pointer; border-radius: 3px;">
              Eliminar
            </button>
          </div>
        `).join('');
      } catch (err) {
        container.innerHTML = '<p style="color: var(--dim-gray);">No se pudo cargar la lista de artículos.</p>';
      }
    }

    window.deleteArticle = async function(id) {
      if (!confirm('¿Estás seguro de eliminar este artículo?')) return;

      const mutateUrl = `https://${projectId}.api.sanity.io/v2024-01-01/data/mutate/${dataset}`;
      const res = await fetch(mutateUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${currentToken}`
        },
        body: JSON.stringify({ mutations: [{ delete: { id } }] })
      });

      if (res.ok) {
        alert('Artículo eliminado.');
        loadArticlesList();
      } else {
        alert('Error al eliminar el artículo.');
      }
    };

    initAuth();
  </script>
</BaseLayout>
