---
import BaseLayout from '../layouts/BaseLayout.astro';
import { data as fallbackData } from '../data/content.js';
const teamPassword = 'WebEquipoGrosso2026';
const netlifyBuildHook = 'https://api.netlify.com/build_hooks/6a84d5aa629b44809436de94';
const fallbackArticlesJSON = JSON.stringify(fallbackData.articles);
const fallbackNewsJSON = JSON.stringify(fallbackData.news || []);
---

<BaseLayout title="Administración Editorial · Leon Grosso" description="Panel privado de gestión de noticias y artículos para el equipo de prensa.">
  
  <!-- PANTALLA 1: LOGIN SEGURO CON DISEÑO INSTITUCIONAL -->
  <section id="login-section" class="section" style="min-height: 70vh; display: flex; align-items: center;">
    <div class="container" style="max-width: 440px;">
      <div style="background: var(--soft-bg); padding: 2.5rem; border: 1px solid var(--border); text-align: left;">
        <span class="kicker">Área Privada</span>
        <h1 class="t-section" style="margin: 0.75rem 0 0.5rem; font-size: 1.6rem; letter-spacing: -0.02em;">Acceso Editorial</h1>
        <p class="t-body" style="font-size: 0.875rem; color: var(--dim-gray); margin-bottom: 2rem; line-height: 1.5;">
          Ingrese las credenciales de autorización del equipo para gestionar las publicaciones del sitio.
        </p>

        <div id="login-alert" style="display: none; padding: 0.85rem 1rem; margin-bottom: 1.25rem; background: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.3); font-size: 0.8125rem; font-weight: 600;"></div>

        <form id="login-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div>
            <label for="password-input" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
              Clave de acceso
            </label>
            <div style="position: relative; display: flex; align-items: center;">
              <input
                type="password"
                id="password-input"
                required
                placeholder="Introduzca la clave asignada..."
                style="width: 100%; padding: 0.85rem 3.5rem 0.85rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text); border-radius: 0;"
              />
              <button
                type="button"
                id="toggle-password-btn"
                aria-label="Mostrar u ocultar contraseña"
                style="position: absolute; right: 0.75rem; background: transparent; border: none; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; color: var(--dim-gray); padding: 0.25rem 0.5rem;"
              >
                MOSTRAR
              </button>
            </div>
          </div>

          <button
            type="submit"
            style="padding: 1rem 1.5rem; background: var(--leo-blue); color: #000; font-weight: 800; border: none; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: var(--t); margin-top: 0.5rem;"
          >
            Ingresar al panel
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- PANTALLA 2: DASHBOARD EDITORIAL CON SOLAPAS -->
  <div id="admin-panel-content" style="display: none;">
    <section class="page-hero" style="padding-bottom: 1.5rem;">
      <div class="container" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="kicker">Administración</span>
          <h1 class="t-page page-title" style="margin-bottom: 0.25rem;">Panel Editorial<span class="title-dot">.</span></h1>
          <p class="page-hero-lede" style="font-size: 0.95rem; color: var(--dim-gray);">Gestión en tiempo real de noticias en medios y artículos de opinión.</p>
        </div>
        <button id="logout-btn" style="padding: 0.6rem 1.25rem; background: transparent; border: 1px solid var(--border); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; color: var(--dim-gray); transition: var(--t);">
          Cerrar sesión
        </button>
      </div>
    </section>

    <!-- SELECTOR DE SOLAPAS (NOTICIAS VS ARTÍCULOS) -->
    <section style="background: var(--bg); border-bottom: 1px solid var(--border); padding: 0.5rem 0;">
      <div class="container" style="display: flex; gap: 1rem; align-items: center;">
        <button
          type="button"
          id="tab-btn-news"
          class="admin-tab active"
          onclick="switchTab('news')"
          style="padding: 0.85rem 1.5rem; background: var(--leo-blue); color: #000; font-weight: 800; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; border: 1px solid var(--leo-blue); cursor: pointer; transition: all 0.2s ease;"
        >
          📰 NOTICIAS EN MEDIOS
        </button>
        <button
          type="button"
          id="tab-btn-article"
          class="admin-tab"
          onclick="switchTab('article')"
          style="padding: 0.85rem 1.5rem; background: var(--soft-bg); color: var(--text); font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; border: 1px solid var(--border); cursor: pointer; transition: all 0.2s ease;"
        >
          ✍️ ARTÍCULOS / ESCRIBO
        </button>
      </div>
    </section>

    <section class="section" style="padding-top: 2rem;">
      <div class="container">
        
        <!-- ALERTA DE ESTADO GLOBAL -->
        <div id="status-alert" style="display: none; padding: 1rem 1.5rem; margin-bottom: 2rem; font-size: 0.875rem; font-weight: 600; border: 1px solid transparent;"></div>

        <!-- GRID PRINCIPAL -->
        <div style="display: grid; grid-template-columns: 7fr 5fr; gap: 3rem; align-items: start;" class="admin-grid">
          
          <!-- COLUMNA IZQUIERDA: FORMULARIO EDITORIAL -->
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border);">
              <h2 id="form-mode-title" class="t-h3" style="font-size: 1.15rem; font-weight: 800; margin: 0; text-transform: uppercase; letter-spacing: 0.04em;">Nueva noticia</h2>
              <button id="cancel-edit-btn" style="display: none; background: transparent; border: none; color: var(--leo-blue); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; text-decoration: underline;">
                Cancelar edición
              </button>
            </div>

            <form id="editor-form" style="display: flex; flex-direction: column; gap: 1.25rem; background: var(--soft-bg); padding: 2rem; border: 1px solid var(--border);">
              
              <input type="hidden" id="editing-doc-id" value="" />

              <div>
                <label id="title-label" for="title" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Título de la noticia *
                </label>
                <input type="text" id="title" required placeholder="Ej: Leonardo Grosso presentó proyecto sobre..." style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div>
                  <label id="publication-label" for="publication" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                    Medio o portal de prensa *
                  </label>
                  <input type="text" id="publication" required placeholder="Ej: Página/12, Infobae, Clarín" style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
                </div>
                <div>
                  <label for="publishedAt" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                    Fecha de publicación *
                  </label>
                  <input type="date" id="publishedAt" required style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
                </div>
              </div>

              <!-- CAMPO DE AUTORÍA (SOLO VISIBLE EN ARTÍCULOS) -->
              <div id="authors-group" style="display: none;">
                <label for="authors" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Autoría *
                </label>
                <input type="text" id="authors" value="Leonardo Grosso" placeholder="Ej: Leonardo Grosso + Vanina Pasik" style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
              </div>

              <div>
                <label for="excerpt" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Resumen o copete *
                </label>
                <textarea id="excerpt" rows="3" required placeholder="Resumen breve o bajada del contenido..." style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text); resize: vertical; line-height: 1.5;"></textarea>
              </div>

              <div>
                <label for="externalUrl" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Enlace a la nota completa (URL externa) *
                </label>
                <input type="url" id="externalUrl" required placeholder="https://www.pagina12.com.ar/..." style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
              </div>

              <!-- GESTIÓN DE IMÁGENES -->
              <div style="border-top: 1px solid var(--border); padding-top: 1.25rem; margin-top: 0.5rem;">
                
                <div style="background: var(--bg); padding: 1.25rem; border: 1px solid var(--border); margin-bottom: 1.25rem;">
                  <h4 style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.5rem; color: var(--leo-blue);">
                    Guía de optimización de imágenes
                  </h4>
                  <ul style="font-size: 0.8125rem; line-height: 1.6; color: var(--dim-gray); padding-left: 1.1rem; margin: 0 0 0.75rem;">
                    <li><strong>Formato recomendado:</strong> WebP (preferido) o JPG/JPEG.</li>
                    <li><strong>Proporción sugerida:</strong> 16:9 horizontal (1200 × 800 px) o 1:1 cuadrada.</li>
                    <li><strong>Peso sugerido:</strong> Menor a 300 KB.</li>
                  </ul>
                </div>

                <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Fotografía de portada
                </label>

                <!-- Vista previa si existe foto -->
                <div id="image-preview-container" style="display: none; align-items: center; gap: 1rem; margin-bottom: 0.75rem; background: var(--bg); padding: 0.75rem; border: 1px solid var(--border);">
                  <img id="image-preview" src="" alt="Vista previa" style="width: 56px; height: 56px; object-fit: cover;" />
                  <div style="flex: 1;">
                    <span style="font-size: 0.75rem; color: var(--dim-gray); display: block;">Imagen asignada</span>
                    <button type="button" id="remove-image-btn" style="background: transparent; border: none; color: #dc3545; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; cursor: pointer; padding: 0; margin-top: 0.25rem;">
                      Quitar imagen
                    </button>
                  </div>
                </div>

                <input type="file" id="imageFile" accept="image/*" style="width: 100%; padding: 0.5rem; border: 1px dashed var(--border); background: var(--bg); font-size: 0.8125rem;" />
              </div>

              <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.5rem;">
                <input type="checkbox" id="featured" style="width: 18px; height: 18px; accent-color: var(--leo-blue); cursor: pointer;" />
                <label id="featured-label" for="featured" style="font-size: 0.875rem; font-weight: 600; cursor: pointer; color: var(--text);">
                  Destacar esta publicación en la cabecera
                </label>
              </div>

              <button type="submit" id="submit-btn" style="padding: 1.1rem 1.5rem; background: var(--leo-blue); color: #000; font-weight: 800; border: none; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: var(--t); margin-top: 0.5rem;">
                Guardar publicación
              </button>
            </form>
          </div>

          <!-- COLUMNA DERECHA: BARRA EDITORIAL DE REGISTROS -->
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border);">
              <h2 id="sidebar-title" class="t-h3" style="font-size: 1.15rem; font-weight: 800; margin: 0; text-transform: uppercase; letter-spacing: 0.04em;">Noticias registradas</h2>
              <span id="items-count" style="font-size: 0.75rem; font-weight: 700; background: var(--leo-blue); color: #000; padding: 0.2rem 0.6rem; border-radius: 2px;">0</span>
            </div>
            
            <p style="font-size: 0.75rem; color: var(--dim-gray); margin-bottom: 1.25rem; line-height: 1.4;">
              Hacé clic en la estrella <strong>★</strong> para marcar una publicación como destacada principal.
            </p>

            <div id="items-sidebar-list" style="display: flex; flex-direction: column; gap: 0.75rem; max-height: 75vh; overflow-y: auto; padding-right: 0.25rem;">
              Cargando registros...
            </div>
          </div>

        </div>

      </div>
    </section>
  </div>

  <style>
    @media (max-width: 991px) {
      .admin-grid {
        grid-template-columns: 1fr !important;
      }
    }
  </style>

  <script define:vars={{ teamPassword, netlifyBuildHook, fallbackArticlesJSON, fallbackNewsJSON }}>
    window.__NETLIFY_BUILD_HOOK__ = netlifyBuildHook;
    const AUTH_SESSION_KEY = 'leo_admin_session';

    let currentTab = 'news'; // 'news' | 'article'
    let currentNews = [];
    let currentArticles = [];
    let sessionPassword = '';
    let removeImageFlag = false;

    // ── CAPA SEGURA DE API ───────────────────────────────────────────────────
    function getApiEndpoint() {
      return window.location.hostname.includes('netlify.app')
        ? '/.netlify/functions/sanity-mutate'
        : '/api/sanity-mutate';
    }

    async function callMutate(mutations) {
      return fetch(getApiEndpoint(), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: sessionPassword, action: 'mutate', mutations })
      });
    }

    async function callUpload(file) {
      const arrayBuffer = await file.arrayBuffer();
      const uint8 = new Uint8Array(arrayBuffer);
      let binary = '';
      for (let i = 0; i < uint8.byteLength; i++) binary += String.fromCharCode(uint8[i]);
      const imageData = btoa(binary);
      const res = await fetch(getApiEndpoint(), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: sessionPassword, action: 'upload', contentType: file.type, imageData })
      });
      if (!res.ok) throw new Error('Error al subir imagen al servidor.');
      const data = await res.json();
      const docId = data.document?._id || data._id;
      return { _type: 'image', asset: { _type: 'reference', _ref: docId } };
    }

    const SANITY_PUBLIC_URL = 'https://j4xtzihv.api.sanity.io';
    const dataset = 'production';

    const loginSection = document.getElementById('login-section');
    const adminContent = document.getElementById('admin-panel-content');
    const loginForm = document.getElementById('login-form');
    const passwordInput = document.getElementById('password-input');
    const togglePasswordBtn = document.getElementById('toggle-password-btn');
    const loginAlert = document.getElementById('login-alert');
    const logoutBtn = document.getElementById('logout-btn');

    const defaultFallbackArticles = JSON.parse(fallbackArticlesJSON).map(art => ({
      _id: `article-${art.id}`,
      title: art.title,
      publication: art.publication,
      publishedAt: art.date,
      authors: art.author,
      excerpt: art.excerpt,
      externalUrl: art.url,
      featured: Boolean(art.featured),
      image: art.image
    }));

    const defaultFallbackNews = JSON.parse(fallbackNewsJSON).map(item => ({
      _id: `news-${item.id}`,
      title: item.title,
      publication: item.publication,
      publishedAt: item.date,
      excerpt: item.excerpt,
      externalUrl: item.url,
      featured: Boolean(item.featured),
      image: item.image
    }));

    togglePasswordBtn?.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        togglePasswordBtn.textContent = 'OCULTAR';
      } else {
        passwordInput.type = 'password';
        togglePasswordBtn.textContent = 'MOSTRAR';
      }
    });

    function checkAuth() {
      const session = localStorage.getItem(AUTH_SESSION_KEY);
      const savedPwd = sessionStorage.getItem('leo_admin_pwd');
      if (session === 'authenticated' && savedPwd) {
        sessionPassword = savedPwd;
        showAdminPanel();
      } else {
        localStorage.removeItem(AUTH_SESSION_KEY);
        showLoginScreen();
      }
    }

    function showLoginScreen() {
      if (loginSection) loginSection.style.display = 'flex';
      if (adminContent) adminContent.style.display = 'none';
    }

    function showAdminPanel() {
      if (loginSection) loginSection.style.display = 'none';
      if (adminContent) adminContent.style.display = 'block';
      loadAllData();
    }

    loginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const enteredPassword = passwordInput.value.trim();
      if (enteredPassword === teamPassword) {
        sessionPassword = enteredPassword;
        sessionStorage.setItem('leo_admin_pwd', enteredPassword);
        localStorage.setItem(AUTH_SESSION_KEY, 'authenticated');
        showAdminPanel();
      } else {
        if (loginAlert) {
          loginAlert.style.display = 'block';
          loginAlert.textContent = 'Credenciales no autorizadas. Verifique la clave ingresada.';
        }
      }
    });

    logoutBtn?.addEventListener('click', () => {
      sessionPassword = '';
      sessionStorage.removeItem('leo_admin_pwd');
      localStorage.removeItem(AUTH_SESSION_KEY);
      showLoginScreen();
    });

    const dateInput = document.getElementById('publishedAt');
    if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];

    const editorForm = document.getElementById('editor-form');
    const statusAlert = document.getElementById('status-alert');
    const submitBtn = document.getElementById('submit-btn');
    const formModeTitle = document.getElementById('form-mode-title');
    const cancelEditBtn = document.getElementById('cancel-edit-btn');
    const editingDocId = document.getElementById('editing-doc-id');
    const imagePreviewContainer = document.getElementById('image-preview-container');
    const imagePreview = document.getElementById('image-preview');
    const removeImageBtn = document.getElementById('remove-image-btn');

    const titleLabel = document.getElementById('title-label');
    const publicationLabel = document.getElementById('publication-label');
    const authorsGroup = document.getElementById('authors-group');
    const featuredLabel = document.getElementById('featured-label');
    const sidebarTitle = document.getElementById('sidebar-title');

    const tabBtnNews = document.getElementById('tab-btn-news');
    const tabBtnArticle = document.getElementById('tab-btn-article');

    function showAlert(msg, isSuccess = true) {
      if (!statusAlert) return;
      statusAlert.style.display = 'block';
      statusAlert.style.background = isSuccess ? 'rgba(2, 185, 255, 0.1)' : 'rgba(220, 53, 69, 0.1)';
      statusAlert.style.color = isSuccess ? 'var(--text)' : '#dc3545';
      statusAlert.style.borderColor = isSuccess ? 'var(--leo-blue)' : 'rgba(220, 53, 69, 0.3)';
      statusAlert.textContent = msg;
    }

    // ── CAMBIO DE SOLAPAS (NOTICIAS VS ARTÍCULOS) ───────────────────────────
    window.switchTab = function(type) {
      currentTab = type;
      resetForm();

      if (type === 'news') {
        tabBtnNews.style.background = 'var(--leo-blue)';
        tabBtnNews.style.color = '#000';
        tabBtnNews.style.borderColor = 'var(--leo-blue)';
        tabBtnArticle.style.background = 'var(--soft-bg)';
        tabBtnArticle.style.color = 'var(--text)';
        tabBtnArticle.style.borderColor = 'var(--border)';

        formModeTitle.textContent = 'Nueva noticia';
        titleLabel.textContent = 'Título de la noticia *';
        publicationLabel.textContent = 'Medio o portal de prensa *';
        document.getElementById('publication').placeholder = 'Ej: Página/12, Infobae, Clarín';
        document.getElementById('publication').value = '';
        authorsGroup.style.display = 'none';
        featuredLabel.textContent = 'Destacar esta noticia en Lo Último';
        sidebarTitle.textContent = 'Noticias registradas';
      } else {
        tabBtnArticle.style.background = 'var(--leo-blue)';
        tabBtnArticle.style.color = '#000';
        tabBtnArticle.style.borderColor = 'var(--leo-blue)';
        tabBtnNews.style.background = 'var(--soft-bg)';
        tabBtnNews.style.color = 'var(--text)';
        tabBtnNews.style.borderColor = 'var(--border)';

        formModeTitle.textContent = 'Nuevo artículo de opinión';
        titleLabel.textContent = 'Título del artículo *';
        publicationLabel.textContent = 'Medio o publicación *';
        document.getElementById('publication').placeholder = 'Ej: El Cohete a la Luna';
        document.getElementById('publication').value = 'El Cohete a la Luna';
        authorsGroup.style.display = 'block';
        document.getElementById('authors').value = 'Leonardo Grosso';
        featuredLabel.textContent = 'Destacar este artículo en Escribo y portada';
        sidebarTitle.textContent = 'Artículos registrados';
      }

      renderSidebarList();
    };

    removeImageBtn?.addEventListener('click', () => {
      removeImageFlag = true;
      if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
      if (imagePreview) imagePreview.src = '';
      const fileInput = document.getElementById('imageFile');
      if (fileInput) fileInput.value = '';
    });

    function resetForm() {
      if (editorForm) editorForm.reset();
      if (editingDocId) editingDocId.value = '';
      if (formModeTitle) formModeTitle.textContent = currentTab === 'news' ? 'Nueva noticia' : 'Nuevo artículo de opinión';
      if (cancelEditBtn) cancelEditBtn.style.display = 'none';
      if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
      if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
      if (currentTab === 'article') {
        document.getElementById('publication').value = 'El Cohete a la Luna';
        document.getElementById('authors').value = 'Leonardo Grosso';
      }
      removeImageFlag = false;
    }

    cancelEditBtn?.addEventListener('click', resetForm);

    async function uploadImage(file) {
      if (!file) return null;
      return callUpload(file);
    }

    // ── GUARDAR PUBLICACIÓN (NOTICIA O ARTÍCULO) ─────────────────────────────
    editorForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = 'Guardando datos...';
      showAlert('Enviando y actualizando publicación...', true);

      try {
        const isEditing = Boolean(editingDocId.value);
        const docId = editingDocId.value || `${currentTab}-${Date.now()}`;
        const title = document.getElementById('title').value.trim();
        const slugStr = title.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)+/g, "");
        const imageFile = document.getElementById('imageFile')?.files?.[0];
        const isFeatured = document.getElementById('featured').checked;

        let imageAsset = null;
        if (imageFile) {
          imageAsset = await uploadImage(imageFile);
        }

        const currentList = currentTab === 'news' ? currentNews : currentArticles;
        const existingDoc = currentList.find(a => a._id === docId);

        let finalImage = undefined;
        if (imageAsset) {
          finalImage = imageAsset;
        } else if (!removeImageFlag && existingDoc?.image) {
          finalImage = existingDoc.image;
        }

        const doc = {
          _type: currentTab,
          _id: docId,
          title: title,
          slug: { _type: 'slug', current: slugStr },
          publication: document.getElementById('publication').value.trim(),
          publishedAt: document.getElementById('publishedAt').value,
          excerpt: document.getElementById('excerpt').value.trim(),
          externalUrl: document.getElementById('externalUrl').value.trim(),
          featured: isFeatured,
          status: 'published',
          ...(currentTab === 'article' ? { authors: document.getElementById('authors').value.trim() } : {}),
          ...(finalImage ? { image: finalImage } : {})
        };

        const mutations = [];
        if (isFeatured) {
          const others = currentList.filter(a => a.featured && a._id !== docId);
          others.forEach(o => mutations.push({ patch: { id: o._id, set: { featured: false } } }));
        }
        mutations.push({ createOrReplace: doc });

        const res = await callMutate(mutations);

        if (res.ok) {
          showAlert(isEditing ? 'Publicación actualizada correctamente.' : 'Publicación registrada y publicada correctamente en Sanity.', true);
          resetForm();
          await loadAllData();

          const buildHook = window.__NETLIFY_BUILD_HOOK__;
          if (buildHook) fetch(buildHook, { method: 'POST' }).catch(() => {});
        } else {
          const errData = await res.json().catch(() => ({}));
          showAlert(`Error al guardar: ${errData.error || 'Verifique los permisos.'}`, false);
        }
      } catch (err) {
        showAlert(`Error: ${err.message}`, false);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Guardar publicación';
      }
    });

    // ── RENDERIZAR LISTA LATERAL SEGÚN SOLAPA ────────────────────────────────
    function renderSidebarList() {
      const container = document.getElementById('items-sidebar-list');
      const countBadge = document.getElementById('items-count');
      if (!container) return;

      const items = currentTab === 'news' ? currentNews : currentArticles;
      if (countBadge) countBadge.textContent = String(items.length);

      if (items.length === 0) {
        container.innerHTML = `<div style="padding: 1rem; color: var(--dim-gray); font-size: 0.85rem;">No hay ${currentTab === 'news' ? 'noticias' : 'artículos'} cargados todavía.</div>`;
        return;
      }

      container.innerHTML = items.map(art => {
        const isFeatured = Boolean(art.featured);
        
        return `
          <div style="background: ${isFeatured ? 'rgba(2, 185, 255, 0.05)' : 'var(--bg)'}; padding: 0.9rem 1rem; border: 1px solid ${isFeatured ? 'var(--leo-blue)' : 'var(--border)'}; display: flex; flex-direction: column; gap: 0.5rem; position: relative; transition: all 0.2s ease;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem;">
              
              <button 
                onclick="toggleStar('${art._id}', ${!isFeatured})" 
                title="${isFeatured ? 'Publicación destacada' : 'Marcar como destacada'}" 
                style="background: transparent; border: none; font-size: 1.4rem; cursor: pointer; padding: 0; line-height: 1; color: ${isFeatured ? '#FFD700' : 'var(--mid-gray)'}; transition: transform 0.15s ease;"
                onmouseover="this.style.transform='scale(1.2)'"
                onmouseout="this.style.transform='scale(1)'"
              >
                ${isFeatured ? '★' : '☆'}
              </button>

              <div style="flex: 1;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <h4 style="font-size: 0.875rem; font-weight: 700; margin: 0 0 0.25rem; line-height: 1.3; color: var(--text);">${art.title}</h4>
                  ${isFeatured ? '<span style="font-size: 0.65rem; font-weight: 800; background: var(--leo-blue); color: #000; padding: 0.1rem 0.4rem; text-transform: uppercase;">DESTACADA</span>' : ''}
                </div>
                <span style="font-size: 0.72rem; color: var(--dim-gray); display: block;">
                  ${art.publication || 'Medio'} · ${art.publishedAt || ''}
                </span>
              </div>
            </div>

            <div style="display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 0.25rem; border-top: 1px solid var(--border); padding-top: 0.5rem;">
              <button onclick="editItem('${art._id}')" style="background: var(--soft-bg); border: 1px solid var(--border); padding: 0.35rem 0.75rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer; color: var(--text);">
                Editar
              </button>
              <button onclick="deleteItem('${art._id}')" style="background: transparent; color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.4); padding: 0.35rem 0.75rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer;">
                Eliminar
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    // ── CARGAR NOTICIAS Y ARTÍCULOS DESDE SANITY ────────────────────────────
    async function loadAllData() {
      const query = encodeURIComponent(`*[_type in ["article", "news"] && !(_id in path("drafts.**"))] | order(publishedAt desc) {
        _id, _type, title, publication, publishedAt, authors, excerpt, externalUrl, featured, image
      }`);
      const url = `${SANITY_PUBLIC_URL}/v2024-01-01/data/query/${dataset}?query=${query}`;

      try {
        const res = await fetch(url);
        if (res.ok) {
          const json = await res.json();
          const allItems = json.result || [];
          currentNews = allItems.filter(i => i._type === 'news');
          currentArticles = allItems.filter(i => i._type === 'article');

          if (currentArticles.length === 0) currentArticles = defaultFallbackArticles;
          if (currentNews.length === 0) currentNews = defaultFallbackNews;
        } else {
          currentArticles = defaultFallbackArticles;
          currentNews = defaultFallbackNews;
        }
      } catch (err) {
        currentArticles = defaultFallbackArticles;
        currentNews = defaultFallbackNews;
      }

      renderSidebarList();
    }

    // ── ACCIÓN DE ESTRELLA (★) ──────────────────────────────────────────────
    window.toggleStar = async function(id, setFeatured) {
      const currentList = currentTab === 'news' ? currentNews : currentArticles;
      const previouslyFeatured = currentList
        .filter(art => art.featured && art._id !== id)
        .map(art => art._id);

      currentList.forEach(art => {
        art.featured = (art._id === id) ? setFeatured : false;
      });
      renderSidebarList();

      const featuredCheck = document.getElementById('featured');
      if (editingDocId?.value === id && featuredCheck) {
        featuredCheck.checked = setFeatured;
      }

      try {
        const mutations = [];
        if (previouslyFeatured.length > 0) {
          previouslyFeatured.forEach(otherId => {
            mutations.push({ patch: { id: otherId, set: { featured: false } } });
          });
        }
        mutations.push({ patch: { id, set: { featured: setFeatured } } });

        const res = await callMutate(mutations);
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          showAlert(`Error al guardar en Sanity: ${errData.error || 'Error ' + res.status}`, false);
          await loadAllData();
          return;
        }

        showAlert('Destacado actualizado correctamente en Sanity.', true);
        const buildHook = window.__NETLIFY_BUILD_HOOK__;
        if (buildHook) fetch(buildHook, { method: 'POST' }).catch(() => {});

      } catch (e) {
        showAlert(`Error de conexión: ${e.message}`, false);
        loadAllData();
      }
    };

    // ── EDITAR ENTRADA ──────────────────────────────────────────────────────
    window.editItem = function(id) {
      const currentList = currentTab === 'news' ? currentNews : currentArticles;
      const art = currentList.find(a => a._id === id);
      if (!art) return;

      removeImageFlag = false;
      if (editingDocId) editingDocId.value = art._id;
      if (formModeTitle) formModeTitle.textContent = `Editando: ${art.title}`;
      if (cancelEditBtn) cancelEditBtn.style.display = 'inline-block';

      document.getElementById('title').value = art.title || '';
      document.getElementById('publication').value = art.publication || '';
      document.getElementById('publishedAt').value = art.publishedAt || '';
      if (currentTab === 'article') {
        document.getElementById('authors').value = art.authors || 'Leonardo Grosso';
      }
      document.getElementById('excerpt').value = art.excerpt || '';
      document.getElementById('externalUrl').value = art.externalUrl || '';
      document.getElementById('featured').checked = Boolean(art.featured);

      if (art.image) {
        if (imagePreviewContainer) imagePreviewContainer.style.display = 'flex';
        if (imagePreview) {
          if (typeof art.image === 'string') {
            imagePreview.src = art.image;
          } else if (art.image.asset?._ref) {
            const ref = art.image.asset._ref;
            const match = ref.match(/^image-([a-fA-F0-9]+)-(\d+x\d+)-(\w+)$/);
            if (match) {
              imagePreview.src = `https://cdn.sanity.io/images/j4xtzihv/${dataset}/${match[1]}-${match[2]}.${match[3]}`;
            }
          }
        }
      } else {
        if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // ── ELIMINAR ENTRADA ────────────────────────────────────────────────────
    window.deleteItem = async function(id) {
      if (!confirm('¿Confirma la eliminación permanente de esta entrada?')) return;

      try {
        const res = await callMutate([{ delete: { id } }]);
        if (res.ok) {
          if (editingDocId.value === id) resetForm();
          if (currentTab === 'news') {
            currentNews = currentNews.filter(a => a._id !== id);
          } else {
            currentArticles = currentArticles.filter(a => a._id !== id);
          }
          renderSidebarList();

          showAlert('Entrada eliminada correctamente de Sanity.', true);
          const buildHook = window.__NETLIFY_BUILD_HOOK__;
          if (buildHook) fetch(buildHook, { method: 'POST' }).catch(() => {});
        } else {
          showAlert('Ocurrió un inconveniente al eliminar la publicación.', false);
        }
      } catch (err) {
        showAlert(`Error: ${err.message}`, false);
      }
    };

    checkAuth();
  </script>
</BaseLayout>
