---
import BaseLayout from '../layouts/BaseLayout.astro';
const projectId = 'j4xtzihv';
const sanityStudioUrl = `https://manage.sanity.io/projects/${projectId}`;
---

<BaseLayout title="Administración · Leon Grosso" description="Panel de gestión de contenidos y artículos.">
  <section class="section" style="min-height: 70vh; display: flex; align-items: center;">
    <div class="container" style="max-width: 600px; text-align: center;">
      <span class="kicker">Gestión de Contenidos</span>
      <h1 class="t-section" style="margin: 1rem 0;">Panel de Control</h1>
      <p class="t-body" style="margin-bottom: 2rem; color: var(--dim-gray);">
        Ingresá al panel oficial de Sanity para crear, editar, cargar imágenes y publicar artículos en la web.
      </p>

      <a
        href={sanityStudioUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="cookie-btn cookie-btn-primary"
        style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem 2rem; font-size: 1rem; text-decoration: none;"
      >
        Ingresar al Sanity Studio ↗
      </a>

      <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); font-size: 0.8125rem; color: var(--dim-gray);">
        Project ID: <code>{projectId}</code> · Dataset: <code>production</code>
      </div>
    </div>
  </section>
</BaseLayout>
