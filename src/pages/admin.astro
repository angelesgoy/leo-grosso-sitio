---
import BaseLayout from '../layouts/BaseLayout.astro';
import { data as fallbackData } from '../data/content.js';
const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID || 'j4xtzihv';
const dataset = import.meta.env.PUBLIC_SANITY_DATASET || 'production';
const token = import.meta.env.SANITY_API_TOKEN || 'sk806I9qenm35RbkEJX0XlX4VSndFEu6DPy9fbgQEBLBfyXWygkFGNvH4QHa29WYYnMaEVvwwQhXOg6J9jcrJgn3X1IgOOOEEIRbjGBSzNwYok4M0GBSKFVvf8KUwKrXr0hRISeijyWToqHacho1TddhuRtyOBl6nUpoyB9L2VP8lL71JJFX';
const teamPassword = 'WebEquipoGrosso2026';
const fallbackArticlesJSON = JSON.stringify(fallbackData.articles);
---

<BaseLayout title="Administración Editorial · Leon Grosso" description="Panel privado de gestión de contenidos editoriales para el equipo de prensa.">
  
  <!-- PANTALLA 1: LOGIN SEGURO CON DISEÑO INSTITUCIONAL Y CONMUTADOR SVG -->
  <section id="login-section" class="section" style="min-height: 70vh; display: flex; align-items: center;">
    <div class="container" style="max-width: 440px;">
      <div style="background: var(--soft-bg); padding: 2.5rem; border: 1px solid var(--border); text-align: left;">
        <span class="kicker">Área Privada</span>
        <h1 class="t-section" style="margin: 0.75rem 0 0.5rem; font-size: 1.6rem; letter-spacing: -0.02em;">Acceso Editorial</h1>
        <p class="t-body" style="font-size: 0.875rem; color: var(--dim-gray); margin-bottom: 2rem; line-height: 1.5;">
          Ingrese las credenciales de autorización del equipo para gestionar las publicaciones del sitio.
        </p>

        <div id="login-alert" style="display: none; padding: 0.85rem 1rem; margin-bottom: 1.25rem; background: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.3); font-size: 0.8125rem; font-weight: 600;"></div>

        <form id="login-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div>
            <label for="password-input" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: var(--text);">
              Clave de acceso
            </label>
            <div style="position: relative; display: flex; align-items: center;">
              <input
                type="password"
                id="password-input"
                required
                placeholder="Introduzca la clave asignada..."
                style="width: 100%; padding: 0.85rem 3.5rem 0.85rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text); border-radius: 0;"
              />
              <button
                type="button"
                id="toggle-password-btn"
                aria-label="Mostrar u ocultar contraseña"
                style="position: absolute; right: 0.75rem; background: transparent; border: none; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; color: var(--dim-gray); padding: 0.25rem 0.5rem;"
              >
                MOSTRAR
              </button>
            </div>
          </div>

          <button
            type="submit"
            style="padding: 1rem 1.5rem; background: var(--leo-blue); color: #000; font-weight: 800; border: none; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: var(--t); margin-top: 0.5rem;"
          >
            Ingresar al panel
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- PANTALLA 2: DASHBOARD EDITORIAL PROFESIONAL Y GUÍA DE IMÁGENES -->
  <div id="admin-panel-content" style="display: none;">
    <section class="page-hero" style="padding-bottom: 1.5rem;">
      <div class="container" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="kicker">Administración</span>
          <h1 class="t-page page-title" style="margin-bottom: 0.25rem;">Gestión de Artículos<span class="title-dot">.</span></h1>
          <p class="page-hero-lede" style="font-size: 0.95rem; color: var(--dim-gray);">Carga, edición y administración de artículos editoriales en tiempo real.</p>
        </div>
        <button id="logout-btn" style="padding: 0.6rem 1.25rem; background: transparent; border: 1px solid var(--border); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; color: var(--dim-gray); transition: var(--t);">
          Cerrar sesión
        </button>
      </div>
    </section>

    <section class="section" style="padding-top: 2rem;">
      <div class="container">
        
        <!-- ALERTA DE ESTADO GLOBAL -->
        <div id="status-alert" style="display: none; padding: 1rem 1.5rem; margin-bottom: 2rem; font-size: 0.875rem; font-weight: 600; border: 1px solid transparent;"></div>

        <!-- GRID PRINCIPAL -->
        <div style="display: grid; grid-template-columns: 7fr 5fr; gap: 3rem; align-items: start;" class="admin-grid">
          
          <!-- COLUMNA IZQUIERDA: FORMULARIO EDITORIAL -->
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border);">
              <h2 id="form-mode-title" class="t-h3" style="font-size: 1.15rem; font-weight: 800; margin: 0; text-transform: uppercase; letter-spacing: 0.04em;">Nuevo artículo</h2>
              <button id="cancel-edit-btn" style="display: none; background: transparent; border: none; color: var(--leo-blue); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; text-decoration: underline;">
                Cancelar edición
              </button>
            </div>

            <form id="article-form" style="display: flex; flex-direction: column; gap: 1.25rem; background: var(--soft-bg); padding: 2rem; border: 1px solid var(--border);">
              
              <input type="hidden" id="editing-doc-id" value="" />

              <div>
                <label for="title" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Título del artículo *
                </label>
                <input type="text" id="title" required placeholder="Ej: A las armas las carga el narco" style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div>
                  <label for="publication" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                    Medio o publicación *
                  </label>
                  <input type="text" id="publication" required value="El Cohete a la Luna" style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
                </div>
                <div>
                  <label for="publishedAt" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                    Fecha de publicación *
                  </label>
                  <input type="date" id="publishedAt" required style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
                </div>
              </div>

              <div>
                <label for="authors" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Autoría *
                </label>
                <input type="text" id="authors" required value="Leonardo Grosso" placeholder="Ej: Leonardo Grosso + Vanina Pasik" style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
              </div>

              <div>
                <label for="excerpt" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Bajada / Resumen editorial *
                </label>
                <textarea id="excerpt" rows="3" required placeholder="Síntesis sustantiva del contenido..." style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text); resize: vertical; line-height: 1.5;"></textarea>
              </div>

              <div>
                <label for="externalUrl" style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Enlace externo (URL de publicación original) *
                </label>
                <input type="url" id="externalUrl" required placeholder="https://www.elcohetealaluna.com/..." style="width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--border); font-size: 0.95rem; background: var(--bg); color: var(--text);" />
              </div>

              <!-- SECCIÓN DE GESTIÓN Y RECOMENDACIÓN DE IMÁGENES -->
              <div style="border-top: 1px solid var(--border); padding-top: 1.25rem; margin-top: 0.5rem;">
                
                <!-- GUÍA INSTITUCIONAL DE IMÁGENES -->
                <div style="background: var(--bg); padding: 1.25rem; border: 1px solid var(--border); margin-bottom: 1.25rem;">
                  <h4 style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.5rem; color: var(--leo-blue);">
                    Guía de optimización de imágenes
                  </h4>
                  <ul style="font-size: 0.8125rem; line-height: 1.6; color: var(--dim-gray); padding-left: 1.1rem; margin: 0 0 0.75rem;">
                    <li><strong>Formato recomendado:</strong> WebP (preferido) o JPG/JPEG.</li>
                    <li><strong>Proporción y resolución:</strong> 4:5 vertical (1200 × 1500 px) o 16:9 horizontal (1200 × 800 px).</li>
                    <li><strong>Peso sugerido:</strong> Entre 80 KB y 250 KB (máximo absoluto 500 KB por archivo).</li>
                  </ul>
                  <p style="font-size: 0.75rem; color: var(--dim-gray); margin: 0; line-height: 1.4;">
                    Herramientas externas de compresión rápida:
                    <a href="https://tinypng.com" target="_blank" rel="noopener noreferrer" style="color: var(--text); font-weight: 600; text-decoration: underline;">TinyPNG.com ↗</a> o
                    <a href="https://squoosh.app" target="_blank" rel="noopener noreferrer" style="color: var(--text); font-weight: 600; text-decoration: underline;">Squoosh.app ↗</a>.
                  </p>
                </div>

                <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; color: var(--text);">
                  Fotografía de portada
                </label>

                <!-- Vista previa si existe foto -->
                <div id="image-preview-container" style="display: none; align-items: center; gap: 1rem; margin-bottom: 0.75rem; background: var(--bg); padding: 0.75rem; border: 1px solid var(--border);">
                  <img id="image-preview" src="" alt="Vista previa" style="width: 56px; height: 56px; object-fit: cover;" />
                  <div style="flex: 1;">
                    <span style="font-size: 0.75rem; color: var(--dim-gray); display: block;">Imagen asignada al artículo</span>
                    <button type="button" id="remove-image-btn" style="background: transparent; border: none; color: #dc3545; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; cursor: pointer; padding: 0; margin-top: 0.25rem;">
                      Quitar imagen
                    </button>
                  </div>
                </div>

                <input type="file" id="imageFile" accept="image/*" style="width: 100%; padding: 0.5rem; border: 1px dashed var(--border); background: var(--bg); font-size: 0.8125rem;" />
              </div>

              <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.5rem;">
                <input type="checkbox" id="featured" style="width: 18px; height: 18px; accent-color: var(--leo-blue); cursor: pointer;" />
                <label for="featured" style="font-size: 0.875rem; font-weight: 600; cursor: pointer; color: var(--text);">
                  Destacar este artículo en la portada y cabecera de la sección
                </label>
              </div>

              <button type="submit" id="submit-btn" style="padding: 1.1rem 1.5rem; background: var(--leo-blue); color: #000; font-weight: 800; border: none; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: var(--t); margin-top: 0.5rem;">
                Guardar publicación
              </button>
            </form>
          </div>

          <!-- COLUMNA DERECHA: BARRA EDITORIAL DE ARTÍCULOS PUBLICADOS -->
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border);">
              <h2 class="t-h3" style="font-size: 1.15rem; font-weight: 800; margin: 0; text-transform: uppercase; letter-spacing: 0.04em;">Entradas registradas</h2>
              <span id="articles-count" style="font-size: 0.75rem; font-weight: 700; background: var(--leo-blue); color: #000; padding: 0.2rem 0.6rem; border-radius: 2px;">0</span>
            </div>
            
            <p style="font-size: 0.75rem; color: var(--dim-gray); margin-bottom: 1.25rem; line-height: 1.4;">
              Seleccione la estrella para marcar la publicación destacada en portada, o utilice los controles para editar o retirar contenidos.
            </p>

            <div id="articles-sidebar-list" style="display: flex; flex-direction: column; gap: 0.75rem; max-height: 75vh; overflow-y: auto; padding-right: 0.25rem;">
              Cargando registros...
            </div>
          </div>

        </div>

      </div>
    </section>
  </div>

  <style>
    @media (max-width: 991px) {
      .admin-grid {
        grid-template-columns: 1fr !important;
      }
    }
  </style>

  <script define:vars={{ projectId, dataset, token, teamPassword, fallbackArticlesJSON }}>
    const AUTH_SESSION_KEY = 'leo_admin_session';
    const loginSection = document.getElementById('login-section');
    const adminContent = document.getElementById('admin-panel-content');
    const loginForm = document.getElementById('login-form');
    const passwordInput = document.getElementById('password-input');
    const togglePasswordBtn = document.getElementById('toggle-password-btn');
    const loginAlert = document.getElementById('login-alert');
    const logoutBtn = document.getElementById('logout-btn');

    const defaultFallbackArticles = JSON.parse(fallbackArticlesJSON).map(art => ({
      _id: `article-${art.id}`,
      title: art.title,
      publication: art.publication,
      publishedAt: art.date,
      authors: art.author,
      excerpt: art.excerpt,
      externalUrl: art.url,
      featured: Boolean(art.featured),
      image: art.image
    }));

    let currentArticles = [];
    let removeImageFlag = false;

    // Conmutador de la clave en login
    togglePasswordBtn?.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        togglePasswordBtn.textContent = 'OCULTAR';
      } else {
        passwordInput.type = 'password';
        togglePasswordBtn.textContent = 'MOSTRAR';
      }
    });

    function checkAuth() {
      const session = localStorage.getItem(AUTH_SESSION_KEY);
      if (session === 'authenticated') {
        showAdminPanel();
      } else {
        showLoginScreen();
      }
    }

    function showLoginScreen() {
      if (loginSection) loginSection.style.display = 'flex';
      if (adminContent) adminContent.style.display = 'none';
    }

    function showAdminPanel() {
      if (loginSection) loginSection.style.display = 'none';
      if (adminContent) adminContent.style.display = 'block';
      loadArticlesList();
    }

    loginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const enteredPassword = passwordInput.value.trim();
      if (enteredPassword === teamPassword) {
        localStorage.setItem(AUTH_SESSION_KEY, 'authenticated');
        showAdminPanel();
      } else {
        if (loginAlert) {
          loginAlert.style.display = 'block';
          loginAlert.textContent = 'Credenciales no autorizadas. Verifique la clave ingresada.';
        }
      }
    });

    logoutBtn?.addEventListener('click', () => {
      localStorage.removeItem(AUTH_SESSION_KEY);
      showLoginScreen();
    });

    const dateInput = document.getElementById('publishedAt');
    if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];

    const articleForm = document.getElementById('article-form');
    const statusAlert = document.getElementById('status-alert');
    const submitBtn = document.getElementById('submit-btn');
    const formModeTitle = document.getElementById('form-mode-title');
    const cancelEditBtn = document.getElementById('cancel-edit-btn');
    const editingDocId = document.getElementById('editing-doc-id');
    const imagePreviewContainer = document.getElementById('image-preview-container');
    const imagePreview = document.getElementById('image-preview');
    const removeImageBtn = document.getElementById('remove-image-btn');

    function showAlert(msg, isSuccess) {
      if (!statusAlert) return;
      statusAlert.style.display = 'block';
      statusAlert.style.background = isSuccess ? 'rgba(40, 167, 69, 0.1)' : 'rgba(220, 53, 69, 0.1)';
      statusAlert.style.color = isSuccess ? '#155724' : '#dc3545';
      statusAlert.style.borderColor = isSuccess ? 'rgba(40, 167, 69, 0.3)' : 'rgba(220, 53, 69, 0.3)';
      statusAlert.textContent = msg;
    }

    removeImageBtn?.addEventListener('click', () => {
      removeImageFlag = true;
      if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
    });

    function resetForm() {
      articleForm?.reset();
      if (editingDocId) editingDocId.value = '';
      if (formModeTitle) formModeTitle.textContent = 'Nuevo artículo';
      if (cancelEditBtn) cancelEditBtn.style.display = 'none';
      if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
      if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
      removeImageFlag = false;
    }

    cancelEditBtn?.addEventListener('click', resetForm);

    async function uploadImage(file) {
      if (!file) return null;
      const uploadUrl = `https://${projectId}.api.sanity.io/v2024-01-01/assets/images/${dataset}`;
      const res = await fetch(uploadUrl, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': file.type
        },
        body: file
      });
      if (!res.ok) throw new Error('Error al procesar la imagen enviada.');
      const data = await res.json();
      return {
        _type: 'image',
        asset: { _type: 'reference', _ref: data.document._id }
      };
    }

    articleForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = 'Guardando datos...';
      showAlert('Enviando y actualizando publicación...', true);

      try {
        const isEditing = Boolean(editingDocId.value);
        const docId = editingDocId.value || `article-${Date.now()}`;
        const title = document.getElementById('title').value.trim();
        const slugStr = title.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)+/g, "");
        const imageFile = document.getElementById('imageFile')?.files?.[0];
        const isFeatured = document.getElementById('featured').checked;

        let imageAsset = null;
        if (imageFile) {
          imageAsset = await uploadImage(imageFile);
        }

        if (isFeatured) {
          await unsetOtherFeatured(docId);
        }

        const existingDoc = currentArticles.find(a => a._id === docId);

        let finalImage = undefined;
        if (imageAsset) {
          finalImage = imageAsset;
        } else if (!removeImageFlag && existingDoc?.image) {
          finalImage = existingDoc.image;
        }

        const doc = {
          _type: 'article',
          _id: docId,
          title: title,
          slug: { _type: 'slug', current: slugStr },
          publication: document.getElementById('publication').value.trim(),
          publishedAt: document.getElementById('publishedAt').value,
          authors: document.getElementById('authors').value.trim(),
          excerpt: document.getElementById('excerpt').value.trim(),
          externalUrl: document.getElementById('externalUrl').value.trim(),
          featured: isFeatured,
          status: 'published',
          ...(finalImage ? { image: finalImage } : {})
        };

        const mutateUrl = `https://${projectId}.api.sanity.io/v2024-01-01/data/mutate/${dataset}`;
        const res = await fetch(mutateUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({ mutations: [{ createOrReplace: doc }] })
        });

        if (res.ok) {
          showAlert(isEditing ? 'Publicación actualizada correctamente.' : 'Artículo registrado y publicado correctamente.', true);
          resetForm();
          await loadArticlesList();
        } else {
          const errData = await res.json();
          showAlert(`Error al guardar: ${errData.error?.description || 'Verifique los permisos de acceso.'}`, false);
        }
      } catch (err) {
        showAlert(`Error: ${err.message}`, false);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Guardar publicación';
      }
    });

    async function unsetOtherFeatured(currentId) {
      const featuredArticles = currentArticles.filter(a => a.featured && a._id !== currentId);
      if (featuredArticles.length === 0) return;

      const mutations = featuredArticles.map(art => ({
        patch: {
          id: art._id,
          set: { featured: false }
        }
      }));

      const mutateUrl = `https://${projectId}.api.sanity.io/v2024-01-01/data/mutate/${dataset}`;
      await fetch(mutateUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ mutations })
      });
    }

    async function loadArticlesList() {
      const container = document.getElementById('articles-sidebar-list');
      const countBadge = document.getElementById('articles-count');
      if (!container) return;

      const query = encodeURIComponent(`*[_type == "article"] | order(publishedAt desc) {
        _id, title, publication, publishedAt, authors, excerpt, externalUrl, featured, image
      }`);
      const url = `https://${projectId}.api.sanity.io/v2024-01-01/data/query/${dataset}?query=${query}`;

      try {
        const res = await fetch(url);
        if (res.ok) {
          const json = await res.json();
          const apiArticles = json.result || [];
          if (apiArticles.length > 0) {
            currentArticles = apiArticles;
          } else {
            currentArticles = defaultFallbackArticles;
          }
        } else {
          currentArticles = defaultFallbackArticles;
        }
      } catch (err) {
        currentArticles = defaultFallbackArticles;
      }

      if (countBadge) countBadge.textContent = String(currentArticles.length);

      container.innerHTML = currentArticles.map(art => {
        const isFeatured = Boolean(art.featured);
        
        return `
          <div style="background: var(--bg); padding: 0.9rem 1rem; border: 1px solid ${isFeatured ? 'var(--leo-blue)' : 'var(--border)'}; display: flex; flex-direction: column; gap: 0.5rem; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem;">
              <button onclick="toggleStar('${art._id}', ${!isFeatured})" title="${isFeatured ? 'Publicación destacada' : 'Marcar como destacada'}" style="background: transparent; border: none; font-size: 1.1rem; cursor: pointer; padding: 0; line-height: 1; color: ${isFeatured ? 'var(--leo-blue)' : 'var(--mid-gray)'};">
                ${isFeatured ? '★' : '☆'}
              </button>
              <div style="flex: 1;">
                <h4 style="font-size: 0.875rem; font-weight: 700; margin: 0 0 0.25rem; line-height: 1.3; color: var(--text);">${art.title}</h4>
                <span style="font-size: 0.72rem; color: var(--dim-gray); display: block;">
                  ${art.publication || 'Medio'} · ${art.publishedAt || ''}
                </span>
              </div>
            </div>

            <div style="display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 0.25rem; border-top: 1px solid var(--border); padding-top: 0.5rem;">
              <button onclick="editArticle('${art._id}')" style="background: var(--soft-bg); border: 1px solid var(--border); padding: 0.35rem 0.75rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer; color: var(--text);">
                Editar
              </button>
              <button onclick="deleteArticle('${art._id}')" style="background: transparent; color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.4); padding: 0.35rem 0.75rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer;">
                Eliminar
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    window.toggleStar = async function(id, setFeatured) {
      if (setFeatured) {
        await unsetOtherFeatured(id);
      }

      const mutateUrl = `https://${projectId}.api.sanity.io/v2024-01-01/data/mutate/${dataset}`;
      const res = await fetch(mutateUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          mutations: [{
            patch: {
              id: id,
              set: { featured: setFeatured }
            }
          }]
        })
      });

      if (res.ok) {
        const art = currentArticles.find(a => a._id === id);
        if (art) {
          currentArticles.forEach(a => a.featured = false);
          art.featured = setFeatured;
        }
        loadArticlesList();
      }
    };

    window.editArticle = function(id) {
      const art = currentArticles.find(a => a._id === id);
      if (!art) return;

      removeImageFlag = false;
      if (editingDocId) editingDocId.value = art._id;
      if (formModeTitle) formModeTitle.textContent = `Editando entrada: ${art.title}`;
      if (cancelEditBtn) cancelEditBtn.style.display = 'inline-block';

      document.getElementById('title').value = art.title || '';
      document.getElementById('publication').value = art.publication || 'El Cohete a la Luna';
      document.getElementById('publishedAt').value = art.publishedAt || '';
      document.getElementById('authors').value = art.authors || 'Leonardo Grosso';
      document.getElementById('excerpt').value = art.excerpt || '';
      document.getElementById('externalUrl').value = art.externalUrl || '';
      document.getElementById('featured').checked = Boolean(art.featured);

      if (art.image) {
        if (imagePreviewContainer) imagePreviewContainer.style.display = 'flex';
        if (imagePreview) {
          if (typeof art.image === 'string') {
            imagePreview.src = art.image;
          } else if (art.image.asset?._ref) {
            const ref = art.image.asset._ref;
            const match = ref.match(/^image-([a-fA-F0-9]+)-(\d+x\d+)-(\w+)$/);
            if (match) {
              imagePreview.src = `https://cdn.sanity.io/images/${projectId}/${dataset}/${match[1]}-${match[2]}.${match[3]}`;
            }
          }
        }
      } else {
        if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    window.deleteArticle = async function(id) {
      if (!confirm('¿Confirma la eliminación permanente de esta entrada?')) return;

      const mutateUrl = `https://${projectId}.api.sanity.io/v2024-01-01/data/mutate/${dataset}`;
      const res = await fetch(mutateUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ mutations: [{ delete: { id } }] })
      });

      if (res.ok) {
        if (editingDocId.value === id) resetForm();
        currentArticles = currentArticles.filter(a => a._id !== id);
        loadArticlesList();
      } else {
        alert('Ocurrió un inconveniente al eliminar la publicación.');
      }
    };

    checkAuth();
  </script>
</BaseLayout>
