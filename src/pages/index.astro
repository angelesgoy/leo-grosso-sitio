---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeedGrid from '../components/FeedGrid.astro';
import ArticleFeatured from '../components/ArticleFeatured.astro';
import ArticleList from '../components/ArticleList.astro';
import ProjectList from '../components/ProjectList.astro';
import { data } from '../data/content.js';
import { getArticles, getFeed } from '../services/content';

const articles = await getArticles();
const feed = await getFeed(articles);

const featuredArticle = articles.find((article) => article.featured) || (articles.length > 0 ? articles[0] : null);
const homeListArticles = featuredArticle
  ? articles.filter((article) => article.id !== featuredArticle.id).slice(0, 3)
  : articles.slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="container"><div class="grid-hero">
      <div class="reveal">
        <span class="kicker">Vecino de San Martín · Buenos Aires</span>
        <h1 class="t-display hero-title hero-title-spaced"><span class="hero-title-line">LEON</span><span class="hero-title-line">GROSSO<span class="title-dot">.</span></span></h1>
        <p class="hero-sub">Politólogo. Dirigente político. <span class="blue">Exdiputado nacional.</span></p>
        <div class="hero-meta"><span>San Martín, PBA</span><span>UNSAM · Cs. Políticas</span></div>
      </div>
      <div class="reveal"><div class="hero-photo"><img src="/images/principales/retrato-portada.webp" alt="Retrato editorial de Leon Grosso" width="1280" height="1600" fetchpriority="high" decoding="async" /></div></div>
    </div></div>
  </section>

  <section class="section"><div class="container"><div class="grid-60-40 reveal">
    <p class="t-body-lg">Mi trayectoria conecta organización territorial, trabajo legislativo y gestión pública. Fui diputado nacional durante doce años, enfocado en ambiente, Derechos Humanos y economía popular. Desde 2024, soy Administrador General del IDUAR en Moreno.</p>
    <div><a href="/sobre-mi/" class="link-arrow">Leer sobre mí <span class="arrow">→</span></a></div>
  </div></div></section>

  <section class="section"><div class="container">
    <div class="sec-head reveal"><div class="sec-head-title"><span class="kicker">Actualidad</span><h2 class="t-section section-title">Lo último</h2></div><a href="/lo-ultimo/" class="sec-head-link">Ver todo →</a></div>
    <FeedGrid items={feed.slice(0, 4)} />
  </div></section>

  <section class="sanmartin-block"><div class="container"><div class="sanmartin-grid reveal">
    <div><span class="kicker">Territorio</span><h2 class="sanmartin-title section-title">SAN<br />MARTÍN</h2></div>
    <p class="sanmartin-sub">Seguridad, violencia, ambiente, desigualdad. San Martín atraviesa toda mi trayectoria política y sigue siendo el lugar desde donde observo el presente.</p>
    <a href="/san-martin/" class="sanmartin-link">Ver San Martín →</a>
  </div></div></section>

  <section class="section"><div class="container">
    <div class="sec-head reveal"><div class="sec-head-title"><span class="kicker">Producción</span><h2 class="t-section section-title">Escribo</h2></div><a href="/escribe/" class="sec-head-link">Ver todos los textos →</a></div>
    {featuredArticle && <ArticleFeatured article={featuredArticle} />}
    {homeListArticles.length > 0 && <ArticleList articles={homeListArticles} />}
  </div></section>

  <section class="section surface-soft"><div class="container">
    <div class="grid-60-40 reveal"><div><span class="kicker">Archivo legislativo</span><h2 class="t-section section-title">12 años<br />en Diputados</h2></div><div><p class="t-body copy-spaced">2011 — 2023. Hitos curados en ambiente, Derechos Humanos, economía popular, hábitat y seguridad democrática.</p><a href="/trayectoria/" class="link-arrow">Explorar trayectoria <span class="arrow">→</span></a></div></div>
    <div class="stats-grid reveal stats-spaced"><div class="stat"><div class="stat-num">12</div><div class="stat-label">Años en Cámara</div><div class="stat-sub">2011 — 2023</div></div><div class="stat"><div class="stat-num">26.811</div><div class="stat-label">Ley violencia institucional</div><div class="stat-sub">8 de mayo</div></div><div class="stat"><div class="stat-num">RN</div><div class="stat-label">Comisión de Recursos Naturales</div><div class="stat-sub">Presidencia · 2020 — 2023</div></div></div>
  </div></section>

  <section class="section"><div class="container">
    <div class="sec-head reveal"><div class="sec-head-title"><span class="kicker">2024 — presente</span><h2 class="t-section section-title">Gestión · IDUAR</h2></div><a href="/trabajo/" class="sec-head-link">Ver todo el trabajo →</a></div>
    <ProjectList items={data.projects.slice(0, 3)} />
  </div></section>

  <!-- SINCRONIZACIÓN EN TIEMPO REAL DEL ARTÍCULO DESTACADO EN PORTADA -->
  <script is:inline>
    (async function syncFeaturedArticle() {
      try {
        const query = encodeURIComponent('*[_type == "article" && featured == true][0]');
        const res = await fetch(`https://j4xtzihv.api.sanity.io/v2024-01-01/data/query/production?query=${query}`);
        if (!res.ok) return;
        const json = await res.json();
        const featured = json.result;
        if (!featured || !featured.title) return;

        const container = document.querySelector('.article-featured');
        if (!container) return;

        const titleEl = container.querySelector('h3');
        if (titleEl && titleEl.textContent !== featured.title) {
          titleEl.textContent = featured.title;
          
          const metaEl = container.querySelector('.meta');
          if (metaEl) {
            const parts = featured.publishedAt ? featured.publishedAt.split('T')[0].split('-') : [];
            const dateStr = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : '';
            metaEl.innerHTML = `Artículo destacado · ${featured.publication || 'El Cohete a la Luna'} · <time datetime="${featured.publishedAt || ''}">${dateStr}</time>`;
          }

          const authorEl = container.querySelector('.article-author');
          if (authorEl) authorEl.textContent = featured.authors || 'Leonardo Grosso';

          const excerptEl = container.querySelector('.excerpt');
          if (excerptEl) excerptEl.textContent = featured.excerpt || '';

          const linkEl = container.querySelector('.link-arrow');
          if (linkEl) {
            if (featured.externalUrl) linkEl.href = featured.externalUrl;
            linkEl.innerHTML = `Leer en ${featured.publication || 'El Cohete a la Luna'} <span class="arrow">↗</span>`;
          }

          const imgEl = container.querySelector('.thumb img');
          if (imgEl && featured.image?.asset?._ref) {
            const match = featured.image.asset._ref.match(/^image-([a-fA-F0-9]+)-(\d+x\d+)-(\w+)$/);
            if (match) {
              imgEl.src = `https://cdn.sanity.io/images/j4xtzihv/production/${match[1]}-${match[2]}.${match[3]}`;
            }
          }
        }
      } catch (e) {
        // Fallback silencioso
      }
    })();
  </script>
</BaseLayout>
