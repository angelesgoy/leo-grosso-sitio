---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeedGrid from '../components/FeedGrid.astro';
import ProjectList from '../components/ProjectList.astro';
import { data } from '../data/content.js';
import { getArticles, getNews } from '../services/content';
import { createNewsRecords } from '../services/content/sources/news';
import { createArticleRecords } from '../services/content/sources/articles';
import { normalizeLocalRecord } from '../services/content/normalize';

const articles = await getArticles();
const news = await getNews();

// 1. Noticias para Home (la última/destacada como horizontal, siguientes en grilla compacta)
const newsRecords = createNewsRecords(news);
const rawNewsItems = newsRecords.map(normalizeLocalRecord);
const featuredNews = rawNewsItems.find(n => n.featured) || rawNewsItems[0];
const otherNews = rawNewsItems.filter(n => n.id !== featuredNews?.id);
const homeNewsItems = featuredNews ? [
  { ...featuredNews, featured: true },
  ...otherNews.slice(0, 3).map(n => ({ ...n, featured: false }))
] : [];

// 2. Artículos para Home (el último/destacado como horizontal, siguientes en grilla compacta)
const articleRecords = createArticleRecords(articles);
const rawArticleItems = articleRecords.map(normalizeLocalRecord);
const featuredArticle = rawArticleItems.find(a => a.featured) || rawArticleItems[0];
const otherArticles = rawArticleItems.filter(a => a.id !== featuredArticle?.id);
const homeArticleItems = featuredArticle ? [
  { ...featuredArticle, featured: true },
  ...otherArticles.slice(0, 3).map(a => ({ ...a, featured: false }))
] : [];
---

<BaseLayout>
  <section class="hero">
    <div class="container"><div class="grid-hero">
      <div class="reveal">
        <span class="kicker">Vecino de San Martín · Buenos Aires</span>
        <h1 class="t-display hero-title hero-title-spaced"><span class="hero-title-line">LEON</span><span class="hero-title-line">GROSSO<span class="title-dot">.</span></span></h1>
        <p class="hero-sub">Politólogo. Dirigente político. <span class="blue">Exdiputado nacional.</span></p>
        <div class="hero-meta"><span>San Martín, PBA</span><span>UNSAM · Cs. Políticas</span></div>
      </div>
      <div class="reveal"><div class="hero-photo"><img src="/images/principales/retrato-portada.webp" alt="Retrato editorial de Leon Grosso" width="1280" height="1600" fetchpriority="high" decoding="async" /></div></div>
    </div></div>
  </section>

  <section class="section"><div class="container"><div class="grid-60-40 reveal">
    <p class="t-body-lg">Mi trayectoria conecta organización territorial, trabajo legislativo y gestión pública. Fui diputado nacional durante doce años, enfocado en ambiente, Derechos Humanos y economía popular. Desde 2024, soy Administrador General del IDUAR en Moreno.</p>
    <div><a href="/sobre-mi/" class="link-arrow">Leer sobre mí <span class="arrow">→</span></a></div>
  </div></div></section>

  <!-- SECCIÓN NOTICIAS EN MEDIOS (DESTACADA HORIZONTAL + COMPACTAS) -->
  {homeNewsItems.length > 0 && (
    <section class="section"><div class="container">
      <div class="sec-head reveal">
        <div class="sec-head-title">
          <span class="kicker">Actualidad</span>
          <h2 class="t-section section-title">Noticias</h2>
        </div>
        <a href="/lo-ultimo/" class="sec-head-link">Ver todas las noticias →</a>
      </div>
      <FeedGrid id="home-news-grid" items={homeNewsItems} />
    </div></section>
  )}

  <section class="sanmartin-block"><div class="container"><div class="sanmartin-grid reveal">
    <div><span class="kicker">Territorio</span><h2 class="sanmartin-title section-title">SAN<br />MARTÍN</h2></div>
    <p class="sanmartin-sub">Seguridad, violencia, ambiente, desigualdad. San Martín atraviesa toda mi trayectoria política y sigue siendo el lugar desde donde observo el presente.</p>
    <a href="/san-martin/" class="sanmartin-link">Ver San Martín →</a>
  </div></div></section>

  <!-- SECCIÓN ESCRIBO (DESTACADA HORIZONTAL + COMPACTAS) -->
  {homeArticleItems.length > 0 && (
    <section class="section"><div class="container">
      <div class="sec-head reveal">
        <div class="sec-head-title">
          <span class="kicker">Producción</span>
          <h2 class="t-section section-title">Escribo</h2>
        </div>
        <a href="/escribe/" class="sec-head-link">Ver todos los textos →</a>
      </div>
      <FeedGrid id="home-articles-grid" items={homeArticleItems} />
    </div></section>
  )}

  <section class="section surface-soft"><div class="container">
    <div class="grid-60-40 reveal"><div><span class="kicker">Archivo legislativo</span><h2 class="t-section section-title">12 años<br />en Diputados</h2></div><div><p class="t-body copy-spaced">2011 — 2023. Hitos curados en ambiente, Derechos Humanos, economía popular, hábitat y seguridad democrática.</p><a href="/trayectoria/" class="link-arrow">Explorar trayectoria <span class="arrow">→</span></a></div></div>
    <div class="stats-grid reveal stats-spaced"><div class="stat"><div class="stat-num">12</div><div class="stat-label">Años en Cámara</div><div class="stat-sub">2011 — 2023</div></div><div class="stat"><div class="stat-num">26.811</div><div class="stat-label">Ley violencia institucional</div><div class="stat-sub">8 de mayo</div></div><div class="stat"><div class="stat-num">RN</div><div class="stat-label">Comisión de Recursos Naturales</div><div class="stat-sub">Presidencia · 2020 — 2023</div></div></div>
  </div></section>

  <section class="section"><div class="container">
    <div class="sec-head reveal"><div class="sec-head-title"><span class="kicker">2024 — presente</span><h2 class="t-section section-title">Gestión · IDUAR</h2></div><a href="/trabajo/" class="sec-head-link">Ver todo el trabajo →</a></div>
    <ProjectList projects={data.projects.slice(0, 3)} />
  </div></section>

  <!-- SINCRONIZACIÓN EN TIEMPO REAL CON SCRIPTS ESTÁTICOS PUBLICOS -->
  <script is:inline src="/scripts/feed.js"></script>
</BaseLayout>
