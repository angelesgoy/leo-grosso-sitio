---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { data } from '../data/content.js';
---
<BaseLayout title="Trayectoria · Leon Grosso" description="Archivo cronológico de la trayectoria territorial, legislativa y de gestión de Leon Grosso.">
  <PageHero kicker="Cronología" title="Trayectoria" lede="Hitos seleccionados. Todo lo anterior explica el presente." />
  <section class="section"><div class="container"><div class="timeline-list">{data.timeline.map((entry) => <article class="timeline-entry reveal"><div class="timeline-year">{entry.year}</div><div><h3 class="timeline-title">{entry.title}</h3><p class="timeline-desc">{entry.desc}</p></div></article>)}</div></div></section>
  <section class="section surface-soft"><div class="container"><div class="stats-grid reveal"><div class="stat"><div class="stat-num">12</div><div class="stat-label">Años en Diputados</div><div class="stat-sub">2011 — 2023</div></div><div class="stat"><div class="stat-num">26.811</div><div class="stat-label">Ley violencia institucional</div><div class="stat-sub">8 de mayo</div></div><div class="stat"><div class="stat-num">RN</div><div class="stat-label">Recursos Naturales</div><div class="stat-sub">Presidencia · 2020 — 2023</div></div></div></div></section>
</BaseLayout>
