---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FeedGrid from '../components/FeedGrid.astro';
import { getNews } from '../services/content';
import { createNewsRecords } from '../services/content/sources/news';
import { normalizeLocalRecord } from '../services/content/normalize';

const news = await getNews();
const newsRecords = createNewsRecords(news);
const rawNewsItems = newsRecords.map(normalizeLocalRecord);

const featuredNews = rawNewsItems.find((n) => n.featured) || rawNewsItems[0];
const otherNews = rawNewsItems.filter((n) => n.id !== featuredNews?.id);
const allNewsItems = featuredNews ? [
  { ...featuredNews, featured: true },
  ...otherNews.map((n) => ({ ...n, featured: false }))
] : [];
---

<BaseLayout
  title="Noticias · Leon Grosso"
  description="Archivo completo de noticias, notas de prensa y coberturas periodísticas sobre Leon Grosso en medios nacionales y locales."
>
  <PageHero
    kicker="Prensa y Medios"
    title="Noticias"
    lede="Coberturas periodísticas, entrevistas y publicaciones en medios de comunicación sobre Leon Grosso, su labor legislativa y territorial."
  />

  <section class="section">
    <div class="container">
      {allNewsItems.length === 0 ? (
        <div class="feed-empty">No hay noticias registradas por el momento.</div>
      ) : (
        <FeedGrid id="news-portal-grid" items={allNewsItems} />
      )}
    </div>
  </section>

  <!-- SINCRONIZACIÓN EN TIEMPO REAL DESDE SANITY -->
  <script is:inline>
    async function syncNoticiasPortal() {
      const grid = document.getElementById('news-portal-grid');
      if (!grid) return;

      try {
        const query = encodeURIComponent(`*[_type == "news" && !(_id in path("drafts.**")) && (status == "published" || !defined(status))] | order(publishedAt desc) {
          _id, title, publication, publishedAt, excerpt, image, externalUrl, featured
        }`);
        const res = await fetch(`https://j4xtzihv.api.sanity.io/v2024-01-01/data/query/production?query=${query}`);
        if (!res.ok) return;

        const json = await res.json();
        const items = json.result || [];
        if (items.length === 0) return;

        const formatted = items.map((item) => {
          const parts = item.publishedAt ? item.publishedAt.split('T')[0].split('-') : [];
          const displayDate = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : '';
          let imgUrl = '';
          if (typeof item.image === 'string') {
            imgUrl = item.image;
          } else if (item.image?.asset?._ref) {
            const match = item.image.asset._ref.match(/^image-([a-fA-F0-9]+)-(\d+x\d+)-(\w+)$/);
            if (match) {
              imgUrl = `https://cdn.sanity.io/images/j4xtzihv/production/${match[1]}-${match[2]}.${match[3]}`;
            }
          }
          return {
            id: item._id,
            title: item.title,
            publication: item.publication || 'Medio',
            date: item.publishedAt || '',
            displayDate: displayDate,
            excerpt: item.excerpt || '',
            url: item.externalUrl || '#',
            image: imgUrl,
            featured: Boolean(item.featured)
          };
        });

        const featured = formatted.find((n) => n.featured) || formatted[0];
        const others = formatted.filter((n) => n.id !== featured.id);
        const sorted = featured ? [featured, ...others] : formatted;

        grid.innerHTML = sorted.map((item, idx) => {
          if (idx === 0) {
            return `
              <article class="feed-item featured" data-feed-item data-feed-groups="noticias">
                <div class="feed-item-media">
                  ${item.image 
                    ? `<img src="${item.image}" alt="${item.title}" width="1920" height="1200" loading="lazy" decoding="async" />` 
                    : `<span class="feed-item-media-label">Imagen · 16:10</span>`}
                </div>
                <div class="feed-item-body">
                  <div class="feed-item-meta">
                    <span>NOTICIA · ${item.publication.toUpperCase()}</span>
                    ${item.displayDate ? `<span class="sep">·</span><time datetime="${item.date}">${item.displayDate}</time>` : ''}
                  </div>
                  <h3 class="feed-item-title">${item.title}</h3>
                  <p class="feed-item-excerpt">${item.excerpt}</p>
                  ${item.url && item.url !== '#' ? `<div class="feed-link"><a href="${item.url}" target="_blank" rel="noopener noreferrer" class="link-arrow">Leer noticia <span class="arrow">↗</span></a></div>` : ''}
                </div>
              </article>
            `;
          }

          return `
            <article class="feed-item span-4" data-feed-item data-feed-groups="noticias">
              <div class="feed-item-media square">
                ${item.image 
                  ? `<img src="${item.image}" alt="${item.title}" width="1200" height="1200" loading="lazy" decoding="async" />` 
                  : `<span class="feed-item-media-label">Imagen · 1:1</span>`}
              </div>
              <div class="feed-item-meta">
                <span>NOTICIA · ${item.publication.toUpperCase()}</span>
                ${item.displayDate ? `<span class="sep">·</span><time datetime="${item.date}">${item.displayDate}</time>` : ''}
              </div>
              <h3 class="feed-item-title">${item.title}</h3>
              <p class="feed-item-excerpt">${item.excerpt}</p>
              ${item.url && item.url !== '#' ? `<div class="feed-link"><a href="${item.url}" target="_blank" rel="noopener noreferrer" class="link-arrow">Leer noticia <span class="arrow">↗</span></a></div>` : ''}
            </article>
          `;
        }).join('');

      } catch (e) {
        // Fallback silencioso
      }
    }

    syncNoticiasPortal();
  </script>
</BaseLayout>
