---
import type { Article } from '../types/content';
const { articles } = Astro.props as { articles: Article[] };
---
<div class="articles-list">
  {articles.map((article) => (
    <article class="article-row reveal">
      <time class="date" datetime={article.date}>{article.displayDate}</time>
      <div class="author">{article.author}</div>
      <div class="title">{article.title}</div>
      <div class="pub">{article.publication}</div>
      <a href={article.url} target="_blank" rel="noopener noreferrer" class="link-arrow" aria-label={`Leer ${article.title}`}><span class="arrow">↗</span></a>
    </article>
  ))}
</div>
