---
import type { Project } from '../types/content';
const { projects, limit, linkLabel = 'IDUAR' } = Astro.props as { projects: Project[]; limit?: number; linkLabel?: string };
const list = limit ? projects.slice(0, limit) : projects;
---
<div class:list={[limit ? 'grid-2col' : 'articles-list']}>
  {list.map((project) => (
    <article class="project-card reveal">
      <div class="project-num">{project.num}</div>
      <div>
        <div class="project-cat">{project.cat}</div>
        <h3 class="project-title">{project.title}</h3>
        <p class="project-sub">{project.sub}</p>
      </div>
      <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-link link-arrow">{linkLabel} <span class="arrow">↗</span></a>
    </article>
  ))}
</div>
